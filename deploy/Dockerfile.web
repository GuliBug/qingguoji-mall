# ---------- 阶段一：构建 Web 管理端 + H5 ----------
FROM node:22-alpine AS builder

ARG NPM_REGISTRY=https://registry.npmmirror.com
# Puppeteer 在容器内无需下载 Chrome（只构建，不跑 E2E）
ARG PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_DOWNLOAD=${PUPPETEER_SKIP_DOWNLOAD}

WORKDIR /build

# ---- Web 管理端 ----
COPY frontend-web/package*.json ./frontend-web/
RUN cd frontend-web && npm ci --registry=${NPM_REGISTRY} --no-audit --no-fund
COPY frontend-web ./frontend-web
RUN cd frontend-web && npm run build:prod

# ---- H5 客户端 ----
COPY frontend-h5/mall-client/package*.json ./frontend-h5/mall-client/
RUN cd frontend-h5/mall-client && npm ci --registry=${NPM_REGISTRY} --no-audit --no-fund
COPY frontend-h5/mall-client ./frontend-h5/mall-client
RUN cd frontend-h5/mall-client && npm run build:h5

# ---------- 阶段二：Nginx 托管 ----------
FROM nginx:1.27-alpine

ENV TZ=Asia/Shanghai

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/frontend-web/dist /usr/share/nginx/html/web
COPY --from=builder /build/frontend-h5/mall-client/dist /usr/share/nginx/html/h5

EXPOSE 80 81
